# NIARVA environment — copy to `.env.local` at the repository root, or run `pnpm setup:env`
# to create it with freshly generated secrets. Never commit a real `.env*` file.

# ---------------------------------------------------------------- web app
# Public origin of this deployment, without a trailing slash.
NIARVA_BASE_URL=http://localhost:3000
# Identifies where proof was produced (local, preview, production). Part of the proof key.
NIARVA_ENVIRONMENT_ID=local

# PostgreSQL connection string (Neon, CI, or a local server).
# Leave empty to use the embedded database stored in `apps/web/.pglite/`.
DATABASE_URL=
# Connections per server instance (keep it small on serverless platforms with a pooled URL).
DATABASE_POOL_MAX=10

# Secrets: at least 32 random characters each. `pnpm setup:env` generates them.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
PREVIEW_TOKEN_SECRET=replace-with-at-least-32-random-characters
IP_HASH_SECRET=replace-with-at-least-32-random-characters

# ---------------------------------------------------------------- AI (optional)
# Without a key and model, the AI path reports "provider unavailable" and the labeled
# template and manual paths are used. Publishing still requires real browser proof.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ---------------------------------------------------------------- verification
# Mandatory Kane probes allowed per full verification before the request is rejected.
KANE_MAX_RUNS_PER_VERIFICATION=10
# Kane browser probes queued in a rolling 24 hours, per workspace and for the whole deployment.
# Every probe spends Kane credits from the operator's account; a request over budget gets 429 and
# queues nothing. Probes canceled before they ran are not counted. 0 disables new browser verification.
KANE_PROBE_BUDGET_PER_WORKSPACE_24H=24
KANE_PROBE_BUDGET_GLOBAL_24H=48
# Enables the seeded demo account and the labeled golden scenario.
DEMO_MODE=false
# Judge accounts (comma-separated emails) that may read, never change, the showcase forms below.
# Active only with DEMO_MODE=true. Create the account with `pnpm seed:judge <baseUrl>`.
DEMO_JUDGE_EMAILS=
# Demo showcase form ids (comma-separated), for example the recorded golden case.
DEMO_SHOWCASE_FORM_IDS=

# ---------------------------------------------------------------- worker
# Shared bearer secret between the web app and the worker (generated by `pnpm setup:env`).
# Kane CLI itself is authenticated separately with `kane-cli login`.
WORKER_SHARED_TOKEN=replace-with-at-least-32-random-characters
# Worker settings: where the web app is, and a label for this machine.
NIARVA_WORKER_API_URL=http://localhost:3000
NIARVA_WORKER_ID=local-worker-1
# Optional: the Test Manager project id Kane must upload to; the worker refuses to start otherwise.
NIARVA_KANE_PROJECT_ID=

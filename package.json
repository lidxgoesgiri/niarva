{
  "name": "niarva",
  "version": "0.1.0",
  "private": true,
  "description": "Intent-preserving conditional form builder with real-browser verification by Kane CLI.",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @niarva/web dev",
    "build": "pnpm --filter @niarva/web build",
    "start": "pnpm --filter @niarva/web start",
    "worker": "pnpm --filter @niarva/worker start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @niarva/core --filter @niarva/contracts --filter @niarva/worker test",
    "test:integration": "pnpm --filter @niarva/web test",
    "db:generate": "pnpm --filter @niarva/web db:generate",
    "db:migrate": "pnpm --filter @niarva/web db:migrate",
    "setup:env": "node scripts/setup-env.mjs",
    "verify:kane": "node scripts/verify-kane.mjs",
    "kane:locked": "node scripts/kane-locked.mjs",
    "test:e2e": "node scripts/verify-kane.mjs",
    "seed:kane": "node scripts/seed-kane-fixtures.mjs",
    "seed:kane:proven": "node scripts/seed-proven-fixtures.mjs",
    "m0:lab": "node m0-lab/serve.mjs 4310",
    "m0:manifest": "node m0-lab/build-manifest.mjs"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "eslint": "~9.39.5",
    "eslint-config-next": "~16.4.6",
    "prettier": "~3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.72.2"
  }
}
